# ==============================================================================
# PLUCK ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env (e.g. backend/.env or root .env) and fill in your actual credentials.
# NEVER commit your actual .env file with secrets to Git.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
# Atlas SRV Connection format:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/pluck?retryWrites=true&w=majority
# Local MongoDB fallback:
# MONGODB_URI=mongodb://127.0.0.1:27017/pluck
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/pluck?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. SERVER PORT & BASE URL
# ------------------------------------------------------------------------------
PORT=4000
PLUCK_APP_BASE_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 3. SMTP EMAIL NOTIFICATIONS (Optional for live email delivery)
# ------------------------------------------------------------------------------
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
PLUCK_MAIL_FROM=notifications@pluck.dev

# ------------------------------------------------------------------------------
# 4. OPTIONAL AI & OAUTH INTEGRATIONS (PRD §2.4.5 & §2.4.6)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# ------------------------------------------------------------------------------
# 5. JWT & SESSION CRYPTOGRAPHIC SIGNING SECRET
# ------------------------------------------------------------------------------
# JWT_SECRET=generate-a-strong-random-256-bit-secret-here

